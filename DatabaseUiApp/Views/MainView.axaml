<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DatabaseUiApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DatabaseUiApp.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>

 <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*">
     
     <ProgressBar Grid.ColumnSpan="2" Grid.Row="0"
                  Height="15" 
                  IsVisible="{Binding IsLoading}"
                  IsIndeterminate="True"/>

     <Button Grid.Row="1" Grid.Column="0"
             Content="+ Add movie"
             Margin="8"
             Command="{Binding OpenAddFilmCommand}"
             />

	 <ListBox Grid.Row="2" Grid.Column="0" 
              ItemsSource="{Binding Films}"
              SelectedItem="{Binding SelectedFilm}"
              DisplayMemberBinding="{Binding Title}"/>

     <StackPanel Grid.Row="1" Grid.Column="1" 
                 Margin="16"
                 >
         <TextBlock Text="{Binding SelectedFilm.Title}" FontSize="20"
                    FontWeight="Bold"/>
         <TextBlock Text="{Binding SelectedFilm.Year}"/>
         <TextBlock Text="{Binding SelectedFilm.Duration}"/>
         <TextBlock Text="{Binding SelectedFilm.Genre.Name}"/>
         <TextBlock Text="{Binding SelectedFilm.Director.Name}" 
                    FontSize="20"
                    FontWeight="Bold"/>
         
		 
     </StackPanel>
                
 </Grid>
</UserControl>
